NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>
REDIS_URL=redis://<redis-host>:6379
JWT_SECRET=<replace_with_64_plus_character_random_secret>
AI_SERVICE_URL=https://<ai-service-domain>
CLIENT_URL=https://<frontend-domain>
CORS_ORIGINS=https://<frontend-domain>
LOG_LEVEL=info
SERVICE_NAME=finexa-backend
APP_VERSION=2.0.0
OPENAI_API_KEY=<optional_openai_key>
OTEL_ENABLED=true
